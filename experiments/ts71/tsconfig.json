{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2026",
		"lib": ["es2026", "dom"],
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"contentMappers": [
		{
			"package": "svelte-script-mapper",
			"extensions": [".svelte"]
		}
	],
	"include": ["src"]
}
